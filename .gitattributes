# Normalize line endings in the repository to LF.
#
# Without this, editing a file on Windows rewrote every line with CRLF and git
# reported the whole file as changed: a five-line edit to app.py showed up as
# 7385 changed lines, which makes reviewing a diff impossible.
* text=auto eol=lf

# Shell scripts and Dockerfiles must keep LF even when checked out on Windows.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Windows batch files only work with CRLF.
*.bat text eol=crlf

# Never touch binary payloads.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.mkv binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.tflite binary
*.pt binary
*.zip binary
