# Secrets. The Dockerfile does "COPY . ." — without these the .env and the
# exported YouTube cookies get baked into an image layer and travel with it.
.env
.env.*
!.env.example
cookies.txt
*_cookies.txt

# Runtime data. Recreated by the Dockerfile; copying it in would bloat the
# build context with every clip ever rendered.
output/
uploads/

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
.eggs/
*.egg-info/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Video files (will be mounted via volume)
*.mp4
*.avi
*.mov
*.mkv
*.gif
videos/

# Model files (downloaded at build time)
*.pt

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Docs
README.md
*.md







