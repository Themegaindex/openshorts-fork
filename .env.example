# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Quality gate: if YouTube offers less than this height, ask the user before
# starting the job instead of silently processing a soft source (0 = off).
# QUALITY_GATE_MIN_HEIGHT=720

# Watermark (optional — defaults shown). A subtle centered overlay is burned
# into every rendered clip so they can't be re-uploaded as someone else's work.
# WATERMARK_TEXT wins over the image; without both, the bundled OpenShorts logo
# is used. Set WATERMARK_ENABLED=0 to turn it off entirely.
# WATERMARK_ENABLED=1
# WATERMARK_TEXT=
# WATERMARK_IMAGE=
# WATERMARK_OPACITY=0.08
# WATERMARK_WIDTH_FRACTION=0.45

# Whisper transcription (optional — defaults shown)
# Model size: tiny/base/small/medium/large-v3. "small" is a good speed/quality
# tradeoff for German; "base" is faster but noticeably worse.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Gemini models (optional — defaults shown). GEMINI_MODEL overrides all tasks
# at once; the task-specific variables override GEMINI_MODEL for that task.
# Pricing per 1M tokens: 3.1-flash-lite $0.25/$1.50 (best value — cheaper AND
# smarter than 2.5-flash), 3-flash-preview $0.50/$3.00, 2.5-flash $0.30/$2.50.
# GEMINI_MODEL=
# GEMINI_MODEL_ANALYSIS=gemini-3.1-flash-lite
# GEMINI_MODEL_EDITOR=gemini-3-flash-preview
# GEMINI_MODEL_THUMBNAIL=gemini-3-flash-preview
# GEMINI_MODEL_IMAGE=gemini-3.1-flash-image-preview
# GEMINI_MODEL_SAAS=gemini-3-flash-preview

# Clip selection limits. Normal videos keep the existing 10-window shortlist;
# sources at least two hours long inspect 15 windows, but never output more
# than 10 clips and never pad the result with weak candidates.
# GEMINI_SHORTLIST_LIMIT=10
# GEMINI_LONG_VIDEO_SECONDS=7200
# GEMINI_LONG_SHORTLIST_LIMIT=15
# GEMINI_MAX_CLIPS=10
# Hard per-job cap for one-window SCORE recovery calls after incomplete Gemini
# responses. Batch calls are unaffected; excess windows are recorded as skipped.
# GEMINI_MAX_SCORE_RESCUE_CALLS=16
# If Auto finds neither Shorts nor a long edit, render the complete source only
# up to this duration. Set to 0 to disable the full-video Auto fallback.
# AUTO_FULL_VIDEO_FALLBACK_MAX_SECONDS=1800

# Long Video / Smart-Auto V2 (optional — defaults shown). Gemini chooses an
# honest 4-10 minute duration from the available strong material. It plans with
# stable transcript-unit IDs, then an independent review/repair pass gates it.
# LONGFORM_MIN_OUTPUT_SECONDS=240
# LONGFORM_MAX_OUTPUT_SECONDS=600
# Auto only tries a long video above this source length; Long mode uses the
# hard bound below it.
# LONGFORM_MIN_SOURCE_SECONDS=720
# LONGFORM_HARD_MIN_SOURCE_SECONDS=240
# LONGFORM_MIN_SEGMENT_SECONDS=20
# LONGFORM_MAX_SEGMENT_SECONDS=240
# LONGFORM_MAX_SEGMENTS=12
# LONGFORM_MAX_CHAPTERS=6
# Minimum distinct chapters; set to 1 for genuinely single-topic sources.
# LONGFORM_MIN_CHAPTERS=2
# LONGFORM_COLD_OPEN=1
# LONGFORM_COLD_OPEN_MAX_SECONDS=15
# LONGFORM_STRONG_PAUSE_SECONDS=0.55
# LONGFORM_PAUSE_FALLBACK_WINDOW_SECONDS=24
# LONGFORM_BOUNDARY_PADDING_SECONDS=0.20
# LONGFORM_AUDIO_FADE_SECONDS=0.01
# LONGFORM_REVIEW_MIN_OVERALL_SCORE=85
# LONGFORM_REVIEW_MIN_JOIN_SCORE=80
# LONGFORM_REVIEW_REPAIR_RETRIES=1
# Local transcript context available to Gemini before/after every planned cut.
# The time window is capped by the unit limit so long sources stay bounded.
# LONGFORM_REVIEW_BOUNDARY_WINDOW_SECONDS=75
# LONGFORM_REVIEW_BOUNDARY_MAX_UNITS=24
# Scene detection is bounded to this tiny window per planned cut; the full
# source is never scanned for Longform boundary alignment.
# LONGFORM_SCENE_SCAN_MAX_SECONDS=1.5
# LONGFORM_SCENE_CUT_THRESHOLD=18
# LONGFORM_CANVAS_WIDTH=1920
# LONGFORM_CANVAS_HEIGHT=1080
# GEMINI_LONGFORM_TIMEOUT_SECONDS=600
# GEMINI_THINKING_LONGFORM=low

# Thinking for the clip-scoring stage (optional). off = model default (cheapest).
# "low"/"high" (Gemini 3 thinking_level) or a token budget number (Gemini 2.5).
# Thinking tokens bill at the OUTPUT rate — enable only if clip choice matters more than cost.
# GEMINI_THINKING_SCORE=off
